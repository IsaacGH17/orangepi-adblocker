#!/bin/sh
# S60dnspark — init de Busybox para dnspark
DAEMON=/usr/bin/dnspark
BLOCKLIST=/etc/dnspark/blocklist
PIDFILE=/var/run/dnspark.pid

case "$1" in
  start)
    printf "Starting dnspark: "
    start-stop-daemon -S -b -m -p $PIDFILE -x $DAEMON -- -b $BLOCKLIST
    [ $? = 0 ] && echo "OK" || echo "FAIL"
    ;;
  stop)
    printf "Stopping dnspark: "
    start-stop-daemon -K -p $PIDFILE -x $DAEMON
    [ $? = 0 ] && echo "OK" || echo "FAIL"
    ;;
  restart)
    "$0" stop
    sleep 1
    "$0" start
    ;;
  *)
    echo "Usage: $0 {start|stop|restart}"
    exit 1
    ;;
esac
